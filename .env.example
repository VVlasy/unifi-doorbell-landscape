# Standalone (docker compose) configuration. Not used by the HA app.
# See unifi_doorbell_landscape/DOCS.md.
#
# Option A - manual: enable camera SSH on the console yourself and fill the
# camera's Recovery Code here.
CAMERA_IP=192.168.1.23
CAMERA_SSH_PASS=CHANGEME-camera-recovery-code

# Option B - wizard: leave CAMERA_SSH_PASS empty and fill the console SSH
# credentials; the container enables camera SSH and extracts the Recovery
# Code from the newest Protect backup on startup (values are NOT persisted
# in standalone mode - copy them here from the log afterwards).
CONSOLE_HOST=
CONSOLE_SSH_USER=root
CONSOLE_SSH_PASS=

# auto = probe the camera and pick the model build; or force a folder name
# from unifi_doorbell_landscape/rotation/models/
CAMERA_MODEL=auto

# Orientation. none | 90 | -90  (90 and -90 are the two landscape directions,
# 180 deg apart - pick whichever is upright for your mount).
ROTATION=90

# Advanced: set these three directly to bypass the ROTATION mapping above
# (leave them commented unless you know the firmware's hallway semantics).
# HALLWAY_VALUE=0
# ISP_FLIP=1
# ISP_MIRROR=1

ROTATION_CHECK_INTERVAL=30
