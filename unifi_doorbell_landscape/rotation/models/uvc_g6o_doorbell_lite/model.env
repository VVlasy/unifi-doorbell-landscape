# Model definition: UniFi Doorbell Lite (G6O, Sigmastar Infinity6E, ARMv7 HF, glibc 2.30)
# Sourced by camera-rotation-watchdog.sh during model resolution.

MODEL_NAME="UniFi Doorbell Lite (G6O, Sigmastar Infinity6E)"

# Extended regex matched (case-insensitive) against the camera probe output
# (board info files, firmware version strings, uname). First model that
# matches wins. Keep patterns specific enough not to claim other models.
MODEL_MATCH="G6O|Doorbell[ _-]?Lite"

# Mangled C++ getters rot90.so interposes. The probe greps these in the
# camera's /bin/ubnt_streamer; if absent, this rot90.so will not work there.
REQUIRED_SYMBOLS="_ZN4ubnt7encoder20VideoEncoderSettings11hallwayModeEv _ZN4ubnt3ipc8messages13VideoSettings11hallwayModeEv"

# Notes for maintainers:
# - rot90.so built against THIS firmware's glibc 2.30 (camlib/, not in git).
#   Build cmd in rot90.c header.
# - Streamer restart: SIGTERM only. SIGKILL reboots the camera.
